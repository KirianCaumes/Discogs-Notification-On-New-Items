<!doctype html>
<html>

<head>
    <meta
        name="viewport"
        content="width=device-width"
    />
    <meta
        http-equiv="Content-Type"
        content="text/html; charset=UTF-8"
    />
    <title>Error(s)</title>
</head>

<body>
    <p>
        <b>{{failuresLength}}</b> error{{#if isPlural}}s{{/if}} during the run at {{date}}:
    </p>
    {{#each failures}}
    <p>
        <b>{{this.context}}</b>
        <br />
        <code style="white-space: pre-wrap">{{this.message}}</code>
    </p>
    {{/each}}
    <br />
    <p style="font-size: 10px; font-style: italic">
        Automatically generated by
        <a
            href="https://github.com/KirianCaumes/Discogs-notification-on-new-items"
            target="_blank"
            rel="noopener"
        >Discogs Notification On New Items</a>.
    </p>
</body>

</html>
