# Comma separated ids
DISCOGS_ARTIST_IDS=123456
# Optional, raises the rate limit of the Discogs API
DISCOGS_API_KEY=
# Optional, SQLite database of the releases already seen (default: data/project.db)
DB_PATH=

# At least one notification channel must be set

# Mail notification (leave MAIL_HOST empty to disable), e.g. MAIL_HOST=smtp.sendgrid.net, MAIL_USER=apikey
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO=

# Discord notification (leave empty to disable), e.g. https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_URL=

LOCALE=EN-us
